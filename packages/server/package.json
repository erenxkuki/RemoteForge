{
  "name": "@remoteforge/server",
  "version": "0.1.0",
  "description": "RemoteForge central API and authorization service",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "remoteforge-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p . && (copy src\\db\\schema.sql dist\\db\\schema.sql >nul 2>nul || true)",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@remoteforge/shared": "file:../shared",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "zod": "^3.23.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12"
  }
}